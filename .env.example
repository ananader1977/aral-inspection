# Copy to .env (or set in Render). Everything except SUPERADMIN_PASSWORD has a sensible default.
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/app.db

# Owner account (created on first start; setting the password resets it on every start)
SUPERADMIN_EMAIL=ananader1@gmail.com
SUPERADMIN_NAME=Anas
SUPERADMIN_PASSWORD=

# Two-step sign-in for Super Admin, Admin, Technical Manager and Accountant (keep true)
REQUIRE_2FA=true

# Demo users (admin, inspector, technical manager, accountant), inspectors and equipment
SEED_DEMO=false
DEMO_PASSWORD=

# Gmail (app password from Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ananader1@gmail.com
SMTP_PASS=
SMTP_FROM=A R A L Property Inspection Services <ananader1@gmail.com>

# Google Drive for photos and PDFs (used from Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Card payments: mock = demo checkout (card 4242 4242 4242 4242), stripe = live
PAYMENT_PROVIDER=mock
# AI photo suggestions. AI_PROVIDER=gemini (Google, free tier) or claude (Anthropic, paid).
# Leave the key empty to hide the "Suggest from photo" buttons. AI_MODEL is optional.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Nightly database backup (to Google Drive when set up). BACKUP_KEY encrypts the copies; keep it safe.
BACKUP_KEY=

# Phone notifications for the mobile app (see mobile/README.md). Optional.
# Android: the Firebase service-account JSON (or the same in base64)
FCM_SERVICE_ACCOUNT=
# iPhone: Apple Push key (.p8 content), its key id and your team id
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
BACKUP_KEEP=30
